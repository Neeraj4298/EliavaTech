# ---------------------------------------------------------------------------
# EliavaTech environment variables. Copy to .env.local for development.
# In production set these in your host (e.g. Vercel project settings).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://eliavatech.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919121334113
NEXT_PUBLIC_CAL_LINK=eliava-tech-icmfdj/30min
# Social profile links (full https:// URLs). A profile is shown only when set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# Blog drafts are hidden in production. Set to "true" only on a private preview.
SHOW_DRAFT_POSTS=

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Apply the schema with:  npm run db:migrate:deploy
DATABASE_URL=

# --- Spam protection (Cloudflare Turnstile) ---------------------------------
# REQUIRED in production: forms are refused when the secret is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (shared Redis, Upstash REST API) -------------------------
# Recommended in production. Without these the limit is per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Client IP detection (for rate limiting) --------------------------------
# X-Forwarded-For is NOT trusted by default because visitors can fake it.
# On Vercel nothing is needed. Otherwise set ONE of:
#   TRUSTED_IP_HEADER   header your proxy/CDN always overwrites, e.g. cf-connecting-ip
#   TRUSTED_PROXY_COUNT number of trusted proxies in front of the app, e.g. 1
TRUSTED_IP_HEADER=
TRUSTED_PROXY_COUNT=

# --- Email ------------------------------------------------------------------
NOTIFY_EMAIL=supporteliavatech@gmail.com
# Option A: Gmail SMTP (use a Google app password)
SMTP_USER=supporteliavatech@gmail.com
GMAIL_APP_PASSWORD=
# Option B: Resend. RESEND_FROM_EMAIL must be on a domain verified in Resend,
# e.g. "EliavaTech <hello@eliavatech.com>". The shared onboarding@resend.dev
# test sender is blocked in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- AI chat (Google Gemini) ------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Automation / analytics (optional) --------------------------------------
N8N_WEBHOOK_URL=
NEXT_PUBLIC_GA_ID=
